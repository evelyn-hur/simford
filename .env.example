# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role key — server-only, bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI — used only for embeddings (text-embedding-3-small)
OPENAI_API_KEY=sk-...

# Evaluation baseline (ablation) mode. When "true", the chat API serves a
# STATELESS NPC: identity prompt + the current conversation's messages only —
# no memory retrieval, no relationship state, and no off-screen social context.
# Background memory writes and end-of-conversation judging still run, so you can
# compare what the stateful machinery would have done. Override per request with
# the `X-Eval-Mode: baseline` (or `X-Eval-Mode: full`) header. Default: off.
BASELINE_MODE=false
